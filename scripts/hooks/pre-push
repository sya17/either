#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# The full gate before anything leaves the machine: the same list CI runs (justfile, `just check`).
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' is not installed; install it (docs/development/setup.md)." >&2
    exit 1
fi
exec just check
