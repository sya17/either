#!/usr/bin/env bash
# First line must be a Conventional Commit (docs/development/workflow.md). CI repeats this check.
set -uo pipefail

msg="$(grep -v '^#' "$1" | head -n1)"
case "$msg" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "*) exit 0 ;;
esac

re='^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+$'
if [[ ! "$msg" =~ $re ]] || ((${#msg} > 72)); then
    {
        echo "commit-msg: first line must be 'type(scope): description', at most 72 characters."
        echo "  types: feat fix perf refactor docs style test build ci chore revert"
        echo "  got:   $msg"
        echo "  see docs/development/workflow.md"
    } >&2
    exit 1
fi

# Per-clone word list; no list means no check.
list="$(git rev-parse --git-path info/forbidden-words)"
if [[ -s "$list" ]] && grep -v '^#' "$1" | grep -Ei -f "$list" >/dev/null; then
    echo "commit-msg: the message matches the local word list (info/forbidden-words); rewrite it." >&2
    exit 1
fi
