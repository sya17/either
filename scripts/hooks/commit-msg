#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# The first line must be a Conventional Commit (docs/development/workflow.md). Local hooks run afterwards.
set -uo pipefail

msg="$(grep -v '^#' "$1" | head -n1)"
case "$msg" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "*) exit 0 ;;
esac

re='^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+$'
if [[ ! "$msg" =~ $re ]] || ((${#msg} > 72)); then
    {
        echo "commit-msg: the first line must be 'type(scope): description', at most 72 characters."
        echo "  types: feat fix perf refactor docs style test build ci chore revert"
        echo "  got:   $msg"
        echo "  see docs/development/workflow.md"
    } >&2
    exit 1
fi

# shellcheck source=scripts/lib/hooks.sh
. "$(git rev-parse --show-toplevel)/scripts/lib/hooks.sh"
run_local_hook commit-msg "$1"
